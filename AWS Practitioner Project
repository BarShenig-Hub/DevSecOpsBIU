# This was my final project in AWS practitioner course that I represented in front of the whole class.
# This Step Functions state machine automatically creates an IAM role and instance profile, finds VPC resources, launches and configures an EC2 instance with an attached EBS volume and web page.
# Then monitors it, sends a notification, and handles restarts or re-creation if the instance or volume changes state.



{
  "Comment": "A description of my state machine",
  "StartAt": "CreateRole",
  "States": {
    "CreateRole": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:iam:createRole",
      "Parameters": {
        "RoleName": "EC2WithSSMRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      },
      "Next": "AttachSSMPolicy"
    },
    "AttachSSMPolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:iam:attachRolePolicy",
      "Parameters": {
        "RoleName": "EC2WithSSMRole",
        "PolicyArn": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
      },
      "Next": "CreateInstanceProfile"
    },
    "CreateInstanceProfile": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:iam:createInstanceProfile",
      "Parameters": {
        "InstanceProfileName": "EC2WithSSMRole"
      },
      "Next": "AddRoleToInstanceProfile"
    },
    "AddRoleToInstanceProfile": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:iam:addRoleToInstanceProfile",
      "Parameters": {
        "InstanceProfileName": "EC2WithSSMRole",
        "RoleName": "EC2WithSSMRole"
      },
      "Next": "WaitForProfile10Sec"
    },
    "WaitForProfile10Sec": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "GetCustomVPC"
    },
    "GetCustomVPC": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVpcs",
      "Parameters": {
        "Filters": [
          {
            "Name": "tag:Name",
            "Values": [
              "Simple-VPC"
            ]
          }
        ]
      },
      "ResultSelector": {
        "VpcId.$": "$.Vpcs[0].VpcId"
      },
      "ResultPath": "$.VpcInfo",
      "Next": "GetPublicSubnet"
    },
    "GetPublicSubnet": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeSubnets",
      "Parameters": {
        "Filters": [
          {
            "Name": "vpc-id",
            "Values.$": "States.Array($.VpcInfo.VpcId)"
          },
          {
            "Name": "tag:Name",
            "Values": [
              "Simple-VPC-PublicSubnet1-us-east-1a-30.0.1.0/24"
            ]
          }
        ]
      },
      "ResultSelector": {
        "SubnetId.$": "$.Subnets[0].SubnetId"
      },
      "ResultPath": "$.SubnetInfo",
      "Next": "GetSecurityGroup"
    },
    "GetSecurityGroup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeSecurityGroups",
      "Parameters": {
        "Filters": [
          {
            "Name": "vpc-id",
            "Values.$": "States.Array($.VpcInfo.VpcId)"
          },
          {
            "Name": "tag:Name",
            "Values": [
              "Simple-VPC-All-Traffic-SG"
            ]
          }
        ]
      },
      "ResultSelector": {
        "SecurityGroupId.$": "$.SecurityGroups[0].GroupId"
      },
      "ResultPath": "$.SecurityGroupInfo",
      "Next": "CreateVolume"
    },
    "CreateVolume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createVolume",
      "Parameters": {
        "AvailabilityZone": "us-east-1a",
        "Size": 5,
        "VolumeType": "gp3",
        "TagSpecifications": [
          {
            "ResourceType": "volume",
            "Tags": [
              {
                "Key": "Name",
                "Value": "EBS-Project"
              }
            ]
          }
        ]
      },
      "ResultPath": "$.CreateVolumeResult",
      "Next": "CreateNewInstance"
    },
    "CreateNewInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:runInstances",
      "Parameters": {
        "ImageId": "ami-052064a798f08f0d3",
        "InstanceType": "t3.micro",
        "MinCount": 1,
        "MaxCount": 1,
        "IamInstanceProfile": {
          "Name": "EC2WithSSMRole"
        },
        "UserData.$": "States.Base64Encode('#!/bin/bash\nyum update -y\nyum install -y httpd\nsystemctl start httpd\nsystemctl enable httpd')",
        "SubnetId.$": "$.SubnetInfo.SubnetId",
        "SecurityGroupIds.$": "States.Array($.SecurityGroupInfo.SecurityGroupId)",
        "TagSpecifications": [
          {
            "ResourceType": "instance",
            "Tags": [
              {
                "Key": "Name",
                "Value": "StepFunctionInstance"
              },
              {
                "Key": "managed_by",
                "Value": "StepFunction"
              }
            ]
          }
        ]
      },
      "ResultPath": "$.CreateInstanceResult",
      "Next": "Wait20Sec"
    },
    "Wait20Sec": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "AttachEBSVolume"
    },
    "AttachEBSVolume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:attachVolume",
      "Parameters": {
        "InstanceId.$": "$.CreateInstanceResult.Instances[0].InstanceId",
        "VolumeId.$": "$.CreateVolumeResult.VolumeId",
        "Device": "/dev/sdb"
      },
      "ResultPath": "$.AttachEBSVolumeResult",
      "Next": "WaitForAttach"
    },
    "WaitForAttach": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "SendSSMCommand"
    },
    "SendSSMCommand": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "InstanceIds.$": "States.Array($.CreateInstanceResult.Instances[0].InstanceId)",
        "DocumentName": "AWS-RunShellScript",
        "Parameters": {
          "commands": [
            "sudo mkfs.ext4 /dev/sdb",
            "sudo mkdir -p /mnt/ebs",
            "sudo mount /dev/sdb /mnt/ebs",
            "cat << 'EOF' | sudo tee /var/www/html/index.html > /dev/null",
            "<html>",
            "<head>",
            "  <title>Login</title>",
            "  <link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">",
            "</head>",
            "<body>",
            "  <div class=\\\"cloud small\\\"></div>",
            "  <div class=\\\"cloud medium\\\"></div>",
            "  <div class=\\\"cloud large\\\"></div>",
            "  <h1>☁️ Cloudy Login ☁️</h1>",
            "  <form method=\\\"POST\\\">",
            "    <input type=\\\"text\\\" name=\\\"username\\\" placeholder=\\\"Username\\\" required><br>",
            "    <input type=\\\"password\\\" name=\\\"password\\\" placeholder=\\\"Password\\\" required><br>",
            "    <button type=\\\"submit\\\">Login ☁️</button>",
            "  </form>",
            "</body>",
            "</html>",
            "EOF"
          ]
        }
      },
      "ResultPath": "$.SSMCommandResult",
      "Next": "Wait10Sec"
    },
    "Wait10Sec": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "GetInstancePublicIP"
    },
    "GetInstancePublicIP": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.CreateInstanceResult.Instances[0].InstanceId)"
      },
      "ResultSelector": {
        "PublicIpAddress.$": "$.Reservations[0].Instances[0].PublicIpAddress"
      },
      "ResultPath": "$.InstanceInfo",
      "Next": "NotifyByEmail"
    },
    "NotifyByEmail": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:407393506426:EC2Notifications",
        "Subject": "New EC2 Instance Created Successfully",
        "Message.$": "States.Format('Hello, New EC2 instance has been created successfully. You can access it using the following link: http://{}', $.InstanceInfo.PublicIpAddress)"
      },
      "ResultPath": "$.NotifyByEmailResult",
      "Next": "CheckInstanceState"
    },
    "CheckInstanceState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.CreateInstanceResult.Instances[0].InstanceId)"
      },
      "ResultSelector": {
        "State.$": "$.Reservations[0].Instances[0].State.Name"
      },
      "ResultPath": "$.InstanceState",
      "Next": "IsTerminated"
    },
    "CheckVolumeState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
      "Parameters": {
        "VolumeIds.$": "States.Array($.CreateVolumeResult.VolumeId)"
      },
      "ResultSelector": {
        "VolumeStatus.$": "$.Volumes[0].State"
      },
      "ResultPath": "$.VolumeState",
      "Next": "IsDetached"
    },
    "IsTerminated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.InstanceState.State",
          "StringEquals": "terminated",
          "Next": "CreateNewInstance"
        },
        {
          "Variable": "$.InstanceState.State",
          "StringEquals": "stopped",
          "Next": "CreateNewInstance"
        },
        {
          "Variable": "$.InstanceState.State",
          "StringEquals": "pending",
          "Next": "FinishProcess"
        }
      ],
      "Default": "CheckVolumeState"
    },
    "IsDetached": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.VolumeState.VolumeStatus",
          "StringEquals": "available",
          "Next": "Wait20Sec"
        }
      ],
      "Default": "WaitAndRecheck"
    },
    "WaitAndRecheck": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "CheckInstanceState"
    },
    "FinishProcess": {
      "Type": "Succeed"
    }
  }
}
